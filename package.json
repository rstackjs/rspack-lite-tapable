{
  "name": "@rspack/lite-tapable",
  "version": "1.1.5",
  "repository": "https://github.com/rstackjs/rspack-lite-tapable",
  "license": "MIT",
  "description": "Lite weight tapable for Rspack",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rs lib",
    "bump": "pnpx bumpp",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "test": "rs test"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@rspack/core": "^2.2.1",
    "@types/node": "^24.13.3",
    "rstack": "^0.7.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
